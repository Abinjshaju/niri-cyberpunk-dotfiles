{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "color": {
            "1": "cyan",
            "2": "magenta"
        },
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "color": {
            "keys": "magenta",
            "title": "cyan"
        },
        "separator": " 󰄾 "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "cyan"
        },
        {
            "type": "host",
            "key": "󰌢 HOST",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "󰌽 KERNEL",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "󱑂 UPTIME",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "󰏖 PKGS",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "󱂬 WM",
            "keyColor": "magenta"
        },
        {
            "type": "theme",
            "key": "󰉼 THEME",
            "keyColor": "magenta"
        },
        {
            "type": "icons",
            "key": "󰀻 ICONS",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": "󰞷 TERM",
            "keyColor": "magenta"
        },
        {
            "type": "terminalfont",
            "key": "󰛖 FONT",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "󰍛 CPU",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "󰘚 MEM",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "󰋊 DISK",
            "keyColor": "yellow"
        },
        "break",
        "colors"
    ]
}
